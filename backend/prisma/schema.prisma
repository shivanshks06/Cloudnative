generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  DEVELOPER
  ADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequestType {
  EXTEND_DEADLINE
  REASSIGN_TASK
  BLOCKED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(DEVELOPER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projects      Project[]      @relation("ProjectOwner")
  assignedTasks Task[]         @relation("TaskAssignee")
  createdTasks  Task[]         @relation("TaskCreator")
  activityLogs  ActivityLog[]
  notifications Notification[]
  requests      TaskRequest[]  @relation("DeveloperRequests")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  taskId    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model TaskRequest {
  id          String        @id @default(uuid())
  taskId      String
  userId      String
  type        RequestType
  reason      String
  suggestedDate DateTime?
  suggestedHours Int?
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User          @relation("DeveloperRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId, status])
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([ownerId])
}

model Task {
  id              String        @id @default(uuid())
  title           String
  description     String?
  status          TaskStatus    @default(TODO)
  priority        Priority      @default(MEDIUM)
  projectId       String
  assigneeId      String?
  createdById     String
  estimatedHours  Int?          @default(4)
  dueDate         DateTime?
  order           Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee        User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy       User          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  requests        TaskRequest[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String
  message    String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
